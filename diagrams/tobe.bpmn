      <bpmndi:BPMNEdge id="Flow_Start_idea_T1_di" bpmnElement="Flow_Start_idea_T1">
        <di:waypoint x="286" y="167" />
        <di:waypoint x="310" y="167" />
        <di:waypoint x="310" y="375" />
        <di:waypoint x="334" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T1_T2_di" bpmnElement="Flow_T1_T2">
        <di:waypoint x="454" y="375" />
        <di:waypoint x="502" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T2_GW_go_di" bpmnElement="Flow_T2_GW_go">
        <di:waypoint x="622" y="375" />
        <di:waypoint x="670" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GW_go_End_rej_di" bpmnElement="Flow_GW_go_End_rej">
        <di:waypoint x="695" y="350" />
