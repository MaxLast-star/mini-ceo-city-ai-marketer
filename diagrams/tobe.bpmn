<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_campaign_tobe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.44.0">
  <bpmn:collaboration id="Collab_campaign_tobe">
    <bpmn:participant id="Pool_campaign_tobe" name="Запуск кампании в Городе — как станет" processRef="Process_campaign_tobe" />
    <bpmn:participant id="Ext_0" name="Клиенты Города" />
    <bpmn:messageFlow id="MF_0" sourceRef="T7" targetRef="Ext_0" />
  </bpmn:collaboration>
  <bpmn:process id="Process_campaign_tobe" isExecutable="true">
    <bpmn:laneSet id="LaneSet_tobe">
      <bpmn:lane id="Lane_0" name="Маркетолог сервиса и юрист">
        <bpmn:flowNodeRef>Start_idea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_no</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="AI-агент">
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_cat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_cls</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Судья (правила + модель)">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_judge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_idea" name="Цель сервиса или идея маркетолога">
      <bpmn:outgoing>Flow_Start_idea_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Собрать гипотезы из данных и идей">
      <bpmn:incoming>Flow_Start_idea_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_T2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T2" name="Оценить аудиторию, эффект и слоты (часы)">
      <bpmn:incoming>Flow_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_GW_go</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_go" name="Ценность на контакт выше порога?">
      <bpmn:incoming>Flow_T2_GW_go</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_go_End_rej</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_go_AND_split</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_rej" name="Гипотеза отклонена, причина у маркетолога">
      <bpmn:incoming>Flow_GW_go_End_rej</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="AND_split">
      <bpmn:incoming>Flow_GW_go_AND_split</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_split_T4</bpmn:outgoing>
      <bpmn:outgoing>Flow_AND_split_T3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T4" name="Подобрать условия из каталога и каналы">
      <bpmn:incoming>Flow_AND_split_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_GW_cat</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_cat" name="Условия есть в каталоге?">
      <bpmn:incoming>Flow_T4_GW_cat</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_cat_GW_m</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_cat_T4c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T5" name="Собрать креативы по шаблонам">
      <bpmn:incoming>Flow_GW_m_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_T6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T6" name="Проверить условия, КП, тон и право">
      <bpmn:incoming>Flow_T5_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6_GW_judge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_judge" name="Проверки пройдены?">
      <bpmn:incoming>Flow_T6_GW_judge</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_judge_AND_join</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_judge_GW_m</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="AND_join">
      <bpmn:incoming>Flow_GW_judge_AND_join</bpmn:incoming>
      <bpmn:incoming>Flow_T3_AND_join</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_join_T6r</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:businessRuleTask id="T6r" name="Присвоить класс риска">
      <bpmn:incoming>Flow_AND_join_T6r</bpmn:incoming>
      <bpmn:outgoing>Flow_T6r_GW_cls</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_cls" name="Класс риска?">
      <bpmn:incoming>Flow_T6r_GW_cls</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_cls_GW_send</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_cls_T6h</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_send">
      <bpmn:incoming>Flow_GW_cls_GW_send</bpmn:incoming>
      <bpmn:incoming>Flow_GW_dec_GW_send</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_send_T7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T7" name="Настроить, протестировать, отправить (до 1 дня)">
      <bpmn:incoming>Flow_GW_send_T7</bpmn:incoming>
      <bpmn:outgoing>Flow_T7_C_done</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="C_done" name="Кампания завершилась">
      <bpmn:incoming>Flow_T7_C_done</bpmn:incoming>
      <bpmn:outgoing>Flow_C_done_T8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_C_done">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T8" name="Посчитать итоги к контролю (1 день)">
      <bpmn:incoming>Flow_C_done_T8</bpmn:incoming>
      <bpmn:outgoing>Flow_T8_T9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T9" name="Обновить статистику шаблона и базу знаний">
      <bpmn:incoming>Flow_T8_T9</bpmn:incoming>
      <bpmn:outgoing>Flow_T9_End_ok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ok" name="Вывод готов">
      <bpmn:incoming>Flow_T9_End_ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T3" name="Сегмент, контроль, бронь слотов">
      <bpmn:incoming>Flow_AND_split_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_AND_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_m">
      <bpmn:incoming>Flow_GW_cat_GW_m</bpmn:incoming>
      <bpmn:incoming>Flow_T4c_GW_m</bpmn:incoming>
      <bpmn:incoming>Flow_GW_judge_GW_m</bpmn:incoming>
      <bpmn:incoming>Flow_GW_dec_GW_m</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_m_T5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T6h" name="Решение по карточке (2–40 мин)">
      <bpmn:incoming>Flow_GW_cls_T6h</bpmn:incoming>
      <bpmn:outgoing>Flow_T6h_GW_dec</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_dec" name="Решение?">
      <bpmn:incoming>Flow_T6h_GW_dec</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_dec_GW_send</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_dec_End_no</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_dec_GW_m</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_no" name="Кампания отклонена">
      <bpmn:incoming>Flow_GW_dec_End_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T4c" name="Внести новые условия в каталог (1–3 дня)">
      <bpmn:incoming>Flow_GW_cat_T4c</bpmn:incoming>
      <bpmn:outgoing>Flow_T4c_GW_m</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Start_idea_T1" sourceRef="Start_idea" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_T1_T2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_T2_GW_go" sourceRef="T2" targetRef="GW_go" />
    <bpmn:sequenceFlow id="Flow_GW_go_End_rej" name="Ниже порога" sourceRef="GW_go" targetRef="End_rej" />
    <bpmn:sequenceFlow id="Flow_GW_go_AND_split" name="Выше порога" sourceRef="GW_go" targetRef="AND_split" />
    <bpmn:sequenceFlow id="Flow_AND_split_T4" sourceRef="AND_split" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_AND_split_T3" sourceRef="AND_split" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_T4_GW_cat" sourceRef="T4" targetRef="GW_cat" />
    <bpmn:sequenceFlow id="Flow_GW_cat_GW_m" name="Есть" sourceRef="GW_cat" targetRef="GW_m" />
    <bpmn:sequenceFlow id="Flow_GW_cat_T4c" name="Новые условия" sourceRef="GW_cat" targetRef="T4c" />
    <bpmn:sequenceFlow id="Flow_GW_m_T5" sourceRef="GW_m" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_T5_T6" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_T6_GW_judge" sourceRef="T6" targetRef="GW_judge" />
    <bpmn:sequenceFlow id="Flow_GW_judge_AND_join" name="Да" sourceRef="GW_judge" targetRef="AND_join" />
    <bpmn:sequenceFlow id="Flow_GW_judge_GW_m" name="Нарушение: исправить" sourceRef="GW_judge" targetRef="GW_m" />
    <bpmn:sequenceFlow id="Flow_T3_AND_join" sourceRef="T3" targetRef="AND_join" />
    <bpmn:sequenceFlow id="Flow_AND_join_T6r" sourceRef="AND_join" targetRef="T6r" />
    <bpmn:sequenceFlow id="Flow_T6r_GW_cls" sourceRef="T6r" targetRef="GW_cls" />
    <bpmn:sequenceFlow id="Flow_GW_cls_GW_send" name="К0: политика" sourceRef="GW_cls" targetRef="GW_send" />
    <bpmn:sequenceFlow id="Flow_GW_cls_T6h" name="К1–К3" sourceRef="GW_cls" targetRef="T6h" />
    <bpmn:sequenceFlow id="Flow_GW_dec_GW_send" name="Утвердить" sourceRef="GW_dec" targetRef="GW_send" />
    <bpmn:sequenceFlow id="Flow_GW_send_T7" sourceRef="GW_send" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_T7_C_done" sourceRef="T7" targetRef="C_done" />
    <bpmn:sequenceFlow id="Flow_C_done_T8" sourceRef="C_done" targetRef="T8" />
    <bpmn:sequenceFlow id="Flow_T8_T9" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_T9_End_ok" sourceRef="T9" targetRef="End_ok" />
    <bpmn:sequenceFlow id="Flow_T4c_GW_m" sourceRef="T4c" targetRef="GW_m" />
    <bpmn:sequenceFlow id="Flow_GW_dec_GW_m" name="Вернуть с комментарием" sourceRef="GW_dec" targetRef="GW_m" />
    <bpmn:sequenceFlow id="Flow_T6h_GW_dec" sourceRef="T6h" targetRef="GW_dec" />
    <bpmn:sequenceFlow id="Flow_GW_dec_End_no" name="Отклонить" sourceRef="GW_dec" targetRef="End_no" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_tobe">
    <bpmndi:BPMNPlane id="Plane_tobe" bpmnElement="Collab_campaign_tobe">
