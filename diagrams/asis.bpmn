<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_campaign_asis" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.44.0">
  <bpmn:collaboration id="Collab_campaign_asis">
    <bpmn:participant id="Pool_campaign_asis" name="Запуск кампании в Городе — как есть" processRef="Process_campaign_asis" />
    <bpmn:participant id="Ext_0" name="Клиенты Города" />
    <bpmn:messageFlow id="MF_0" sourceRef="T7" targetRef="Ext_0" />
  </bpmn:collaboration>
  <bpmn:process id="Process_campaign_asis" isExecutable="true">
    <bpmn:laneSet id="LaneSet_asis">
      <bpmn:lane id="Lane_0" name="Маркетолог сервиса">
        <bpmn:flowNodeRef>Start_idea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Проджект">
        <bpmn:flowNodeRef>T4b</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Редакция">
        <bpmn:flowNodeRef>GW_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Юрист">
        <bpmn:flowNodeRef>T6b</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Верстка и запуск">
        <bpmn:flowNodeRef>AND_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Аналитик">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_idea" name="Появилась идея">
      <bpmn:outgoing>Flow_Start_idea_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Сформулировать гипотезу (от 1 дня)">
      <bpmn:incoming>Flow_Start_idea_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_T2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T2" name="Оценить аудиторию и эффект (2 дня)">
      <bpmn:incoming>Flow_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_GW_go</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_go" name="Запускать?">
      <bpmn:incoming>Flow_T2_GW_go</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_go_End_rej</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_go_AND_split</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_rej" name="Гипотеза отклонена">
      <bpmn:incoming>Flow_GW_go_End_rej</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="AND_split">
      <bpmn:incoming>Flow_GW_go_AND_split</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_split_T4</bpmn:outgoing>
      <bpmn:outgoing>Flow_AND_split_T3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T4" name="Выбрать условия и каналы (1–2 дня)">
      <bpmn:incoming>Flow_AND_split_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_T4b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T4b" name="Поставить задачу редакции">
      <bpmn:incoming>Flow_T4_T4b</bpmn:incoming>
      <bpmn:outgoing>Flow_T4b_GW_m</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T5" name="Подготовить креативы (2 дня)">
      <bpmn:incoming>Flow_GW_m_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_T6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T6" name="Сверить с условиями, КП и тоном">
      <bpmn:incoming>Flow_T5_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6_GW_ok</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ok" name="Креативы корректны?">
      <bpmn:incoming>Flow_T6_GW_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_ok_T6b</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_ok_GW_m</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T6b" name="Согласовать (вместе со сверкой 1 день)">
      <bpmn:incoming>Flow_GW_ok_T6b</bpmn:incoming>
      <bpmn:outgoing>Flow_T6b_AND_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="AND_join">
      <bpmn:incoming>Flow_T6b_AND_join</bpmn:incoming>
      <bpmn:incoming>Flow_T3_AND_join</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_join_T7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="T7" name="Настроить и отправить рассылку (3 дня)">
      <bpmn:incoming>Flow_AND_join_T7</bpmn:incoming>
      <bpmn:outgoing>Flow_T7_C_done</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="C_done" name="Кампания завершилась">
      <bpmn:incoming>Flow_T7_C_done</bpmn:incoming>
      <bpmn:outgoing>Flow_C_done_T8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_C_done">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T8" name="Посчитать итоги, написать вывод (5 дней)">
      <bpmn:incoming>Flow_C_done_T8</bpmn:incoming>
      <bpmn:outgoing>Flow_T8_End_ok</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_ok" name="Вывод готов">
      <bpmn:incoming>Flow_T8_End_ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_m">
      <bpmn:incoming>Flow_T4b_GW_m</bpmn:incoming>
      <bpmn:incoming>Flow_GW_ok_GW_m</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_m_T5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Выгрузить сегмент и контроль (1 день)">
      <bpmn:incoming>Flow_AND_split_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_AND_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Start_idea_T1" sourceRef="Start_idea" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_T1_T2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_T2_GW_go" sourceRef="T2" targetRef="GW_go" />
    <bpmn:sequenceFlow id="Flow_GW_go_End_rej" name="Эффект мал" sourceRef="GW_go" targetRef="End_rej" />
    <bpmn:sequenceFlow id="Flow_GW_go_AND_split" name="Эффект есть" sourceRef="GW_go" targetRef="AND_split" />
    <bpmn:sequenceFlow id="Flow_AND_split_T4" sourceRef="AND_split" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_AND_split_T3" sourceRef="AND_split" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_T4_T4b" sourceRef="T4" targetRef="T4b" />
    <bpmn:sequenceFlow id="Flow_T4b_GW_m" sourceRef="T4b" targetRef="GW_m" />
    <bpmn:sequenceFlow id="Flow_GW_m_T5" sourceRef="GW_m" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_T5_T6" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_T6_GW_ok" sourceRef="T6" targetRef="GW_ok" />
    <bpmn:sequenceFlow id="Flow_GW_ok_T6b" name="Ошибок нет" sourceRef="GW_ok" targetRef="T6b" />
    <bpmn:sequenceFlow id="Flow_GW_ok_GW_m" name="Ошибки (8%)" sourceRef="GW_ok" targetRef="GW_m" />
    <bpmn:sequenceFlow id="Flow_T6b_AND_join" sourceRef="T6b" targetRef="AND_join" />
    <bpmn:sequenceFlow id="Flow_T3_AND_join" sourceRef="T3" targetRef="AND_join" />
    <bpmn:sequenceFlow id="Flow_AND_join_T7" sourceRef="AND_join" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_T7_C_done" sourceRef="T7" targetRef="C_done" />
    <bpmn:sequenceFlow id="Flow_C_done_T8" sourceRef="C_done" targetRef="T8" />
    <bpmn:sequenceFlow id="Flow_T8_End_ok" sourceRef="T8" targetRef="End_ok" />
  </bpmn:process>
